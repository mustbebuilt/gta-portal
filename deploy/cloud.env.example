# Staging reference only. Set values through Cloud environment settings.
# Do not upload a real .env or overwrite resource-injected credentials/APP_KEY.
APP_ENV=staging
APP_DEBUG=false
APP_URL=https://REPLACE-WITH-ACTUAL-STAGING-HOST
APP_TIMEZONE=Europe/London
SESSION_DRIVER=database
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=sync
MAIL_MAILER=array
LOG_CHANNEL=stderr
GTA_PASSWORD_RECOVERY_ENABLED=false
GTA_SCHEDULE_PORTAL_REMINDERS=false
# Attach the Cloud database; confirm DB_CONNECTION=mysql or mariadb and its injected values.
# Attach a PRIVATE bucket; use the actual Cloud-injected disk name, not a guessed name.
# GTA_PRIVATE_EVIDENCE_DISK=ACTUAL_PRIVATE_DISK_NAME
# GTA_PRIVATE_EVIDENCE_ALLOWED_DISKS=ACTUAL_PRIVATE_DISK_NAME
# GTA_LEGACY_EVIDENCE_DISK must identify the location of actual older files.
# Explicit correctly configured staging access is available; production remains blocked.
# Enable only in an isolated, correctly configured fictional-data staging environment.
GTA_ENABLE_STAGING_PORTAL=false
# Enable temporarily for the once-only empty-application account setup, then disable.
GTA_ALLOW_INITIAL_ADMIN=false
# Optional staging-only copy workflow; default off, no automatic cutover.
GTA_ENABLE_EVIDENCE_COPY=false
