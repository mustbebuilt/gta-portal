# Cloud reference only. Set values through Laravel Cloud environment settings.
# Do not upload a real .env or overwrite resource-injected credentials/APP_KEY.
APP_ENV=production
APP_DEBUG=false
APP_URL=https://REPLACE-WITH-ACTUAL-HOST
APP_LOCALE=en_GB
APP_TIMEZONE=Europe/London

SESSION_DRIVER=database
SESSION_LIFETIME=60
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=sync
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# Attach the Cloud database; confirm DB_CONNECTION=mysql or mariadb and its injected values.
# Attach a PRIVATE bucket; use the actual Cloud-injected disk name, not a guessed name.
# GTA_PRIVATE_EVIDENCE_DISK=ACTUAL_PRIVATE_DISK_NAME
# GTA_PRIVATE_EVIDENCE_ALLOWED_DISKS=ACTUAL_PRIVATE_DISK_NAME
# GTA_LEGACY_EVIDENCE_DISK=ACTUAL_LEGACY_DISK_NAME

# Pack 82: approved programme block-date rules (four active programmes).
GTA_RPL_DATE_PROGRAMMES=ST0499:1.3,ST0068:1.5,ST0403:1.3,ST0448:1.2

# Pack 82: weekly retention warnings (Mondays 09:00 Europe/London).
# Keep false until controlled tutor/apprentice mail rehearsal and duplicate-prevention checks pass.
GTA_WEEKLY_RETENTION_SCHEDULED=false

# Optional reminders and operational flags (all off by default until deliberately enabled).
GTA_PASSWORD_RECOVERY_ENABLED=false
GTA_SCHEDULE_PORTAL_REMINDERS=false
GTA_SCHEDULE_SUPPORT_PLAN_REMINDERS=false
GTA_APPRENTICE_ALERTS_ENABLED=false
GTA_APPRENTICE_ALERTS_SCHEDULED=false
GTA_APPRENTICE_ALERT_EMAIL_ENABLED=false
GTA_APPRENTICE_ALERT_SMS_ENABLED=false
GTA_ALLOW_INITIAL_ADMIN=false
GTA_ENABLE_EVIDENCE_COPY=false
