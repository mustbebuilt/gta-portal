APP_NAME="GTA Local Test"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8000
APP_LOCALE=en_GB
DB_CONNECTION=sqlite
SESSION_DRIVER=file
SESSION_LIFETIME=60
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
CACHE_STORE=file
QUEUE_CONNECTION=sync
MAIL_MAILER=array
LOG_CHANNEL=single
LOG_LEVEL=warning

GTA_PRIVATE_EVIDENCE_DISK=local
GTA_LEGACY_EVIDENCE_DISK=local
GTA_PRIVATE_EVIDENCE_ALLOWED_DISKS=local

GTA_PASSWORD_RECOVERY_ENABLED=false

# Opt-in daily IN-PORTAL prompt generation only; requires scheduler infrastructure.
GTA_SCHEDULE_PORTAL_REMINDERS=false

# Hosted staging is explicitly opt-in; production remains blocked.
GTA_ENABLE_STAGING_PORTAL=false
GTA_ALLOW_INITIAL_ADMIN=false

# Staging evidence copies only; does not activate new storage or relink records.
GTA_ENABLE_EVIDENCE_COPY=false

# Controlled recovery SMTP pilot: staging only; remains off until deliberately configured.
GTA_STAGING_PASSWORD_RECOVERY_ENABLED=false
GTA_STAGING_RECOVERY_RECIPIENTS=
MAIL_TIMEOUT=10

# Separate controlled staging account onboarding; never enable for real users here.
GTA_STAGING_ONBOARDING_ENABLED=false
GTA_STAGING_ONBOARDING_RECIPIENTS=

# Explicit, reviewed staging reminder mail only; no automatic scheduler dispatch.
GTA_STAGING_REMINDER_MAIL_ENABLED=false
GTA_STAGING_REMINDER_MAIL_RECIPIENTS=

# Separate private, non-cutover recovery rehearsal. Configure a dedicated private target first.
GTA_ENABLE_EVIDENCE_RESTORE_REHEARSAL=false
GTA_EVIDENCE_RESTORE_TARGET_DISKS=

# Pack 09: optional staff MFA staging pilot. OFF affects new enrolment, not confirmed accounts.
GTA_MFA_ENROLMENT_ENABLED=false
GTA_MFA_PILOT_EMAILS=
