APP_NAME="GTA Local Test"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8000
APP_LOCALE=en_GB
DB_CONNECTION=sqlite
SESSION_DRIVER=file
SESSION_LIFETIME=60
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
CACHE_STORE=file
QUEUE_CONNECTION=sync
MAIL_MAILER=array
LOG_CHANNEL=single
LOG_LEVEL=warning

GTA_PRIVATE_EVIDENCE_DISK=local
GTA_LEGACY_EVIDENCE_DISK=local
GTA_PRIVATE_EVIDENCE_ALLOWED_DISKS=local

GTA_PASSWORD_RECOVERY_ENABLED=false

# Opt-in daily IN-PORTAL prompt generation only; requires scheduler infrastructure.
GTA_SCHEDULE_PORTAL_REMINDERS=false

# Hosted staging is explicitly opt-in; production remains blocked.
GTA_ENABLE_STAGING_PORTAL=false
GTA_ALLOW_INITIAL_ADMIN=false

# Staging evidence copies only; does not activate new storage or relink records.
GTA_ENABLE_EVIDENCE_COPY=false
